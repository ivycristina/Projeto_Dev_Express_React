{
  "name": "projeto-dev",
  "private": true,
  "scripts": {
    "start": "pnpm --filter backend start",
    "db:generate": "pnpm --filter backend exec prisma generate",
    "db:validate": "pnpm --filter backend exec prisma validate",
    "db:push": "pnpm --filter backend exec prisma db push",
    "db:studio": "pnpm --filter backend exec prisma studio",
    "server": "pnpm --filter backend dev",
    "client": "pnpm --dir \"Frontend/React projeto\" run dev",
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
